# 运行真实入口，验证配置、Unicode、日志及退出码。
function(run executable expected)
    execute_process(COMMAND "${executable}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error
        ENCODING UTF-8 TIMEOUT 10)
    if(NOT "${status}" STREQUAL "${expected}")
        message(FATAL_ERROR "exit=${status}, expected=${expected}\n${output}\n${error}")
    endif()
    set(output "${output}" PARENT_SCOPE)
    set(error "${error}" PARENT_SCOPE)
endfunction()

run("${PUBLISHER}" 0 --help)
if(NOT output MATCHES "Usage: publisher")
    message(FATAL_ERROR "missing help")
endif()
foreach(app "${PUBLISHER}" "${PLAYER}")
    run("${app}" 0 --check-config)
endforeach()
run("${PUBLISHER}" 0 --config "${SOURCE_DIR}/config/publisher.json" --fps=30 --fps 60
    --video-device "中文摄像头" --set audio.channels=1 --print-config)
string(JSON fps GET "${output}" video fps)
string(JSON channels GET "${output}" audio channels)
string(JSON device GET "${output}" devices video)
if(NOT fps EQUAL 60 OR NOT channels EQUAL 1 OR NOT device STREQUAL "中文摄像头" OR NOT error MATCHES "module=config")
    message(FATAL_ERROR "configuration precedence/Unicode/stdout failed")
endif()
run("${PLAYER}" 0 --config "${SOURCE_DIR}/config/player.json" --audio-device "扬声器" --print-config)
string(JSON device GET "${output}" audio device)
if(NOT device STREQUAL "扬声器")
    message(FATAL_ERROR "player override failed")
endif()

set(fixtures "${CMAKE_CURRENT_BINARY_DIR}/cli-fixtures")
file(MAKE_DIRECTORY "${fixtures}")
file(WRITE "${fixtures}/中文配置.json" "{\"video\":{\"fps\":50}}")
run("${PUBLISHER}" 0 --config "${fixtures}/中文配置.json" --print-config)
string(JSON fps GET "${output}" video fps)
if(NOT fps EQUAL 50)
    message(FATAL_ERROR "Unicode file was not loaded")
endif()
file(WRITE "${fixtures}/bad.json" "{")
run("${PLAYER}" 2 --config "${fixtures}/bad.json" --check-config)
run("${PLAYER}" 2 --config "${fixtures}/missing.json" --check-config)
run("${PUBLISHER}" 2 --width 641 --check-config)
if(NOT error MATCHES "module=config thread=[^ ]+ code=1001.*even")
    message(FATAL_ERROR "configuration diagnostic missing")
endif()
run("${PLAYER}" 2 --url --check-config)
run("${PLAYER}" 2 --log-console=0 --check-config)

set(log "${fixtures}/中文日志.log")
file(WRITE "${log}" "")
foreach(app "${PUBLISHER}" "${PLAYER}")
    run("${app}" 0 --check-config --log-level DEBUG --log-file "${log}" --log-console=false)
    if(NOT error STREQUAL "")
        message(FATAL_ERROR "disabled console emitted logs")
    endif()
endforeach()
file(READ "${log}" text)
if(NOT text MATCHES "publisher startup" OR NOT text MATCHES "player startup")
    message(FATAL_ERROR "file output/append failed")
endif()
run("${PLAYER}" 0 --log-level ERROR --print-config)
if(NOT error STREQUAL "")
    message(FATAL_ERROR "level filtering failed")
endif()
file(WRITE "${fixtures}/blocked" "parent is a file")
run("${PUBLISHER}" 1 --log-file "${fixtures}/blocked/child.log" --check-config)
if(NOT error MATCHES "module=logger thread=[^ ]+ code=1003")
    message(FATAL_ERROR "logger error missing")
endif()
run("${PLAYER}" 1 --log-console=false)
if(NOT error MATCHES "media pipelines are pending")
    message(FATAL_ERROR "fatal diagnostic missing")
endif()
message(STATUS "CLI configuration/logging/error checks passed")

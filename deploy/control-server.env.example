# Copy to /etc/livestreamlab/control-server.env only on initial deployment.
# Owner root:root, mode 0600. Do not commit or print the populated local file.
# Use an independent database business-account password, never a root password.
LSL_DB_PASSWORD=REPLACE_WITH_DATABASE_BUSINESS_ACCOUNT_PASSWORD
# Exactly 43 base64url characters: random 32 bytes, no '=' padding.
# The SAME value must appear in BOTH SRS hook URLs in its local configuration.
LSL_SRS_HOOK_SECRET=REPLACE_WITH_RANDOM_32_BYTE_BASE64URL_SECRET
